"id": "83f34ab8",
"metadata": {},
"outputs": [],
"source": [
"df.info()\n",
"df.describe(include='all')\n",
"print(df.isnull().sum())\n",
"print(df.duplicated().sum())\n",
"print(df.columns.tolist())"
]
},
{
"cell_type": "markdown",
"id": "5bc1f6db",
"metadata": {},
"source": [
"## Step 3: Data Cleaning"
]
},
{
"cell_type": "code",
"execution_count": null,
"id": "c0008511",
"metadata": {},
"outputs": [],
"source": [
"df["discounted_price"]=df["discounted_price"].str.replace("₹","",regex=False).str.replace(",","",regex=False).astype(float)\n",
"df["actual_price"]=df["actual_price"].str.replace("₹","",regex=False).str.replace(",","",regex=False).astype(float)\n",
"df["discount_percentage"]=df["discount_percentage"].str.replace("%","",regex=False).astype(float)\n",
"df["rating"]=pd.to_numeric(df["rating"],errors="coerce")\n",
"df["category"]=df["category"].str.lower().str.split("|")\n",
"df.to_csv("../data/processed/amazon_cleaned.csv",index=False)\n",
"df.info()"
]
},
